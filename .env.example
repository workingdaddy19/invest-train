# .env.example - 환경변수 형식 참고용 (커밋 가능)
# 실제 값은 .env 파일에 작성 (.gitignore에 포함됨)
# EKS 운영환경에서는 K8s Secret으로 주입 (.env 파일 사용 금지)

# ── MLFlow 접속 정보 (필수)
MLFLOW_TRACKING_URI=http://mlflow.mlflow.svc.cluster.local:80
MLFLOW_TRACKING_USERNAME=<mlflow-username>
MLFLOW_TRACKING_PASSWORD=<mlflow-password>

# ── 학습 데이터 (Athena)
ATHENA_DB=mlops
ATHENA_TABLE=altinv_crel_train
ATHENA_S3_OUTPUT=s3://s3-an2-mlops/athena/

# ── MLflow 모델/실험 설정 (선택 - 기본값 사용 가능)
MLFLOW_EXPERIMENT=invest-crel-model
MODEL_CLS_NAME=invest-crel-classification
MODEL_REG_NAME=invest-crel-regression
MODEL_ALIAS=champion

# ── 모델 승격 정책
# false(기본): 새 버전 등록까지만. 사람이 지표 확인 후 champion 수동 부여 (권장)
# true: 학습 직후 새 버전에 champion 자동 부여 (완전 자동 재학습 파이프라인)
AUTO_PROMOTE_CHAMPION=false

# ── AWS 설정
AWS_REGION=ap-northeast-2
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET=s3-an2-mlops

# ── 학습 트리거 보안 (선택)
# 값이 설정되면 POST /train 호출 시 X-Train-Token 헤더 일치를 요구
TRAIN_TOKEN=
